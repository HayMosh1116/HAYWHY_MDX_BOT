# Required persistent authentication storage
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=haywhy_mdx_bot
BOT_ID=haywhy-mdx-primary

# Required to protect /session-generator and its QR/pairing API
SESSION_GENERATOR_KEY=replace-with-a-long-random-secret

# Bot identity and owner
OWNER_NUMBER=2349122761580
OWNER_NAME=Your Name
BOT_NAME=HAYWHY_MDX
PREFIX=.

# Optional legacy settings/session import; MongoDB auth backup is preferred
SESSION_ID=

# Railway/Heroku platform settings
PORT=8080
NODE_ENV=production
